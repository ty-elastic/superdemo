              "query": "SET unmapped_fields=\"NULLIFY\"; FROM traces-apm*, apm-*, traces-*.otel-* | WHERE `service.name` == \"trader\" | WHERE `transaction.type` == \"request\" | WHERE TO_STRING(processor.event) == \"transaction\" OR TO_STRING(processor.event) == \"span\" OR processor.event IS NULL | STATS failure = COUNT(*) WHERE TO_STRING(event.outcome) == \"failure\" OR TO_STRING(status.code) == \"Error\", all = COUNT(*) BY timestamp = TBUCKET(100), resource.attributes.cloud.region | EVAL error_rate = TO_DOUBLE(failure) / all | KEEP timestamp, error_rate, resource.attributes.cloud.region | SORT timestamp"
