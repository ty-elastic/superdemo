        "w": 12,
        "h": 5
      },
      "config": {
        "type": "metric",
        "sampling": 1,
        "ignore_global_filters": false,
        "data_source": {
          "type": "esql",
          "query": "FROM \"metrics-snmp.polling-infra\"\n| WHERE host.device_template == \"cisco_ios\" AND @timestamp >= ?_tstart AND @timestamp < ?_tend\n| STATS `Unique Switches` = COUNT_DISTINCT(host.sysname)"
