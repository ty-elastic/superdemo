    {
      "id": "08dae52a-7f31-486f-8fac-1d0abab9138c",
      "type": "custom_content",
      "grid": {
        "x": 0,
        "y": 29,
        "w": 48,
        "h": 20
      },
      "config": {
        "esql_query": [
          "TS \"metrics-snmp.polling-infra\"\n| WHERE TRANGE(?_tstart, ?_tend) AND event.category == \"interface\" AND host.device_template == \"cisco_ios\"\n| STATS interface.oper_status = MAX(LAST_OVER_TIME(interface.oper_status)),\n        interface.admin_status = MAX(LAST_OVER_TIME(interface.admin_status)),\n        interface.in_errors = MAX(LAST_OVER_TIME(interface.in_errors)),\n        interface.out_errors = MAX(LAST_OVER_TIME(interface.out_errors)),\n        interface.in_discards = MAX(LAST_OVER_TIME(interface.in_discards)),\n        interface.out_discards = MAX(LAST_OVER_TIME(interface.out_discards)),\n        interface.speed = MAX(LAST_OVER_TIME(interface.speed)),\n        interface.alias = MAX(LAST_OVER_TIME(interface.alias)),\n        interface.index = MAX(LAST_OVER_TIME(interface.index))\n    BY interface.name, host.sysname\n| SORT host.sysname ASC, interface.index ASC"
        ],
        "template": "<style>\n  body {\n    margin: 0;\n    padding: var(--cc-space-l);\n    box-sizing: border-box;\n    font-family: var(--cc-font-family);\n    color: var(--cc-color-text);\n    background: var(--cc-color-background);\n  }\n\n  .empty-state {\n    padding: var(--cc-space-l);\n    text-align: center;\n    color: var(--cc-color-text);\n    opacity: 0.6;\n    font-size: 0.875rem;\n  }\n\n  .switch-group {\n    margin-bottom: var(--cc-space-l);\n  }\n  .switch-group:last-child {\n    margin-bottom: 0;\n  }\n\n  .switch-header {\n    font-size: 0.875rem;\n    font-weight: 600;\n    margin-bottom: var(--cc-space-s);\n    padding-bottom: var(--cc-space-xs);\n    border-bottom: 1px solid var(--cc-color-border);\n  }\n\n  .port-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(4.25rem, 1fr));\n    gap: var(--cc-space-xs);\n  }\n\n  .tile {\n    position: relative;\n    aspect-ratio: 1 / 1;\n    border-radius: var(--cc-radius-s);\n    border: 1px solid var(--cc-color-border);\n    padding: var(--cc-space-xs);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    overflow: hidden;\n    box-sizing: border-box;\n  }\n\n  .tile-up {\n    background: color-mix(in srgb, var(--cc-color-accent) 20%, var(--cc-color-surface));\n  }\n  .tile-down {\n    background: color-mix(in srgb, var(--cc-color-danger) 20%, var(--cc-color-surface));\n  }\n  .tile-disabled {\n    background: var(--cc-color-surface);\n    opacity: 0.55;\n  }\n\n  .port-name {\n    font-size: 0.75rem;\n    font-weight: 600;\n    line-height: 1.1;\n    white-space: nowrap;\n  }\n\n  .status-dot {\n    position: absolute;\n    top: var(--cc-space-xs);\n    right: var(--cc-space-xs);\n    width: 0.5rem;\n    height: 0.5rem;\n    border-radius: 50%;\n  }\n  .dot-up { background: var(--cc-color-accent); }\n  .dot-down { background: var(--cc-color-danger); }\n  .dot-disabled { background: var(--cc-color-border); }\n\n  .alias {\n    font-size: 0.625rem;\n    line-height: 1.1;\n    margin-top: 2px;\n    opacity: 0.75;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    max-width: 100%;\n  }\n\n  .errors {\n    font-size: 0.625rem;\n    font-weight: 600;\n    margin-top: 2px;\n    color: var(--cc-color-danger);\n  }\n\n  .tooltip {\n    position: absolute;\n    top: calc(100% + var(--cc-space-xs));\n    left: 0;\n    z-index: 10;\n    width: max-content;\n    max-width: 12rem;\n    background: var(--cc-color-surface);\n    border: 1px solid var(--cc-color-border);\n    border-radius: var(--cc-radius-s);\n    padding: var(--cc-space-xs) var(--cc-space-s);\n    font-size: 0.75rem;\n    box-shadow: 0 2px 8px rgba(0,0,0,0.2);\n    opacity: 0;\n    pointer-events: none;\n    transition: opacity var(--cc-motion-fast) var(--cc-ease);\n    text-align: left;\n  }\n  .tile:hover .tooltip {\n    opacity: 1;\n  }\n\n  .tooltip-row {\n    white-space: nowrap;\n  }\n  .tooltip-label {\n    opacity: 0.6;\n    margin-right: var(--cc-space-xs);\n  }\n</style>\n\n{% if rows.size == 0 %}\n  <div class=\"empty-state\">No interface data available.</div>\n{% else %}\n  {% assign prev_host = \"\" %}\n  {% for row in rows %}\n    {% assign cur_host = row[\"host.sysname\"].value %}\n    {% if cur_host != prev_host %}\n      {% unless forloop.first %}\n        </div></div>\n      {% endunless %}\n      <div class=\"switch-group\">\n        <div class=\"switch-header\">{{ cur_host }}</div>\n        <div class=\"port-grid\">\n    {% endif %}\n    {% assign prev_host = cur_host %}\n\n    {% assign short_name = row[\"interface.name\"].value\n      | replace: \"TenGigabitEthernet\", \"Te\"\n      | replace: \"GigabitEthernet\", \"Gi\"\n      | replace: \"FastEthernet\", \"Fa\"\n      | replace: \"Port-channel\", \"Po\"\n      | replace: \"Ethernet\", \"Eth\" %}\n\n    {% assign admin_down = false %}\n    {% assign oper_up = false %}\n    {% if row[\"interface.admin_status\"].value == \"DOWN\" %}\n      {% assign admin_down = true %}\n    {% endif %}\n    {% if row[\"interface.oper_status\"].value == \"UP\" %}\n      {% assign oper_up = true %}\n    {% endif %}\n\n    {% assign in_err = row[\"interface.in_errors\"].value %}\n    {% assign out_err = row[\"interface.out_errors\"].value %}\n\n    {% if admin_down %}\n      <div class=\"tile tile-disabled\">\n        <span class=\"status-dot dot-disabled\"></span>\n    {% elsif oper_up %}\n      <div class=\"tile tile-up\">\n        <span class=\"status-dot dot-up\"></span>\n    {% else %}\n      <div class=\"tile tile-down\">\n        <span class=\"status-dot dot-down\"></span>\n    {% endif %}\n\n        <div class=\"port-name\">{{ short_name }}</div>\n        {% if row[\"interface.alias\"].value != blank %}\n          <div class=\"alias\">{{ row[\"interface.alias\"].value }}</div>\n        {% endif %}\n        {% if in_err > 0 or out_err > 0 %}\n          <div class=\"errors\">⚠ {{ in_err }}/{{ out_err }}</div>\n        {% endif %}\n\n        <div class=\"tooltip\">\n          <div class=\"tooltip-row\"><span class=\"tooltip-label\">Port:</span>{{ row[\"interface.name\"].value }}</div>\n          {% if row[\"interface.alias\"].value != blank %}\n            <div class=\"tooltip-row\"><span class=\"tooltip-label\">Alias:</span>{{ row[\"interface.alias\"].value }}</div>\n          {% endif %}\n          <div class=\"tooltip-row\"><span class=\"tooltip-label\">Admin:</span>{{ row[\"interface.admin_status\"].value }}</div>\n          <div class=\"tooltip-row\"><span class=\"tooltip-label\">Oper:</span>{{ row[\"interface.oper_status\"].value }}</div>\n          <div class=\"tooltip-row\"><span class=\"tooltip-label\">In errors:</span>{{ in_err }}</div>\n          <div class=\"tooltip-row\"><span class=\"tooltip-label\">Out errors:</span>{{ out_err }}</div>\n          <div class=\"tooltip-row\"><span class=\"tooltip-label\">In discards:</span>{{ row[\"interface.in_discards\"].value }}</div>\n          <div class=\"tooltip-row\"><span class=\"tooltip-label\">Out discards:</span>{{ row[\"interface.out_discards\"].value }}</div>\n        </div>\n      </div>\n  {% endfor %}\n  </div></div>\n{% endif %}"
      }
    }
  ],
  "esql_approximation": false,
  "query": {
    "expression": "",
    "language": "kql"
  },
  "refresh_interval": {
    "pause": true,
    "value": 0
  },
  "tags": [],
  "title": "Cisco IOS Switch Health Monitoring"
}