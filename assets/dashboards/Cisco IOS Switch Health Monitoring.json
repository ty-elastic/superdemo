          "type": "esql",
          "query": "TS metrics-snmp.polling-infra\n| WHERE host.device_template == \"cisco_ios\"\n| STATS `Average CPU Utilization` = AVG(AVG_OVER_TIME(system.cpu.total.norm.pct)) BY `Time` = TBUCKET(75, ?_tstart, ?_tend)"
        },
        "styling": {
          "density": "default",
          "primary": {
            "position": "bottom",
            "labels": {
              "alignment": "left"
            },
            "value": {
              "alignment": "right",
              "sizing": "auto"
            }
          }
        },
        "metrics": [
          {
            "column": "Average CPU Utilization",
            "label": "Average CPU Utilization",
            "format": {
              "type": "percent",
              "decimals": 1,
              "compact": true
            },
            "type": "primary",
            "color": {
              "type": "dynamic",
              "range": "absolute",
